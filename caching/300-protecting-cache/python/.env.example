# PostgreSQL connection
DATABASE_URL=postgresql://workshop:workshop@localhost:5432/bookstore

# Valkey server connection settings
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Cache configuration
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# Circuit breaker configuration
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN=30

# Flask signs its session cookie, which carries the flash messages, with this key.
# When it is unset, the app falls back to a fixed development key, which is fine on
# your own machine. Before running the app anywhere else, set a random value, for
# example the output of: python -c "import secrets; print(secrets.token_hex())"
# SECRET_KEY=
